{
  "name": "prettier-config-escapace",
  "description": "escapace prettier config",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "browsers": false,
  "bugs": "https://github.com/escapace/prettier-config-escapace/issues",
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@escapace/pnpm-pack": "0.8.0",
    "prettier": "3.8.1"
  },
  "engines": {
    "pnpm": ">=10.29.2"
  },
  "files": [
    ".prettierrc.json"
  ],
  "homepage": "https://github.com/escapace/prettier-config-escapace#readme",
  "license": "MPL-2.0",
  "main": ".prettierrc.json",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/prettier-config-escapace",
  "scripts": {
    "build": "echo None",
    "format": "prettier --no-error-on-unmatched-pattern -uw .",
    "pack": "pnpm-pack package --pack-destination lib",
    "test": "prettier --check .prettierrc.json",
    "typecheck": "echo None",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional"
  }
}
